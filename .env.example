# Bootstrap health-only; belum mengaktifkan operasi RAG/provider.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# INF-02 opt-in; startup/probe tetap tanpa inference. Inject HF_TOKEN melalui secret environment.
HF_INFERENCE_ENABLED=false
RETRIEVAL_PROFILE=DENSE
HF_EMBEDDING_BATCH_SIZE=1
HF_RERANKER_BATCH_SIZE=2
HF_MAX_CONCURRENCY=1
HF_MAX_ITEMS=128
HF_MAX_TEXT_CHARS=8192
HF_TIMEOUT_MS=15000
HF_MAX_RESPONSE_BYTES=2097152
# Provider/model/endpoint fixed sesuai ADR-002 dan HF_IDENTITY; tanpa auto-routing/fallback.
HF_TOKEN=

# STORE-01 opt-in; startup tidak membuat/mengubah collection. CLI memakai manifest eksplisit.
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_MS=5000
QDRANT_HTTP_PORT=6333
# QDRANT_API_KEY hanya jika server dikonfigurasi memakai authentication.
QDRANT_API_KEY=
