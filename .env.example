# API-01; provider tetap opt-in. Semua route termasuk health memakai Bearer service token.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
OBSERVATION_DIRECTORY=artifacts/observability/service
API_SERVICE_ID=kotobahub
# Inject secret 16–512 karakter printable tanpa whitespace. Kosong => HTTP 503.
API_SERVICE_TOKEN=
# Wajib cocok dengan snapshot caller dan corpus index kedua mode RAG.
API_CORPUS_VERSION=
API_ALLOWED_MODES=LLM_ONLY,SINGLE_STAGE,ADAPTIVE
API_MAX_CONCURRENT=4
API_MAX_DEADLINE_MS=120000

# INF-02 opt-in; startup/probe tetap tanpa inference. Inject HF_TOKEN melalui secret environment.
HF_INFERENCE_ENABLED=false
RETRIEVAL_PROFILE=DENSE
HF_EMBEDDING_BATCH_SIZE=1
HF_RERANKER_BATCH_SIZE=2
HF_MAX_CONCURRENCY=1
HF_MAX_ITEMS=128
HF_MAX_TEXT_CHARS=8192
HF_TIMEOUT_MS=15000
HF_MAX_RESPONSE_BYTES=2097152
# Provider/model/endpoint fixed sesuai ADR-002 dan HF_IDENTITY; tanpa auto-routing/fallback.
HF_TOKEN=

# STORE-01 opt-in; startup tidak membuat/mengubah collection. CLI memakai manifest eksplisit.
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_MS=5000
QDRANT_HTTP_PORT=6333
# QDRANT_API_KEY hanya jika server dikonfigurasi memakai authentication.
QDRANT_API_KEY=

# BASE-01 opt-in; startup/probe tanpa paid inference.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.6-terra
OPENAI_NORMALIZATION_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_INPUT_CHARS=100000
OPENAI_MAX_RESPONSE_BYTES=2097152
OPENAI_MAX_CONCURRENCY=1
# npm run base:smoke hanya plan; --execute membutuhkan --max-calls=4 --max-budget-usd eksplisit.

# RAG-01 opt-in; manifest fisik eksplisit, tanpa alias/pembacaan jaringan pada startup/probe.
# Memerlukan HF_INFERENCE_ENABLED dan QDRANT_ENABLED; production HF tetap DENSE.
RETRIEVAL_ENABLED=false
RETRIEVAL_INDEX_MANIFEST=research/indexing/data-03-v1/index-manifest.json
RETRIEVAL_LIMIT=5
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_MAX_CONCURRENCY=1
RETRIEVAL_TIMEOUT_MS=5000
RETRIEVAL_MAX_RESPONSE_BYTES=8388608

# Shared context budget for both RAG modes (local conservative planning units, not billed usage).
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_EVIDENCE_CAP_TOKENS=8192
CONTEXT_SAFETY_MARGIN_TOKENS=1024

# RAG-03 structural evidence gate; initial policy awaits pilot, without similarity thresholds.
RAG_MIN_UNIQUE_CHUNKS=1
RAG_MIN_COVERED_SKILLS=1

# ADP-01 provisional structural router; calibration pilot belum dijalankan.
# Router initial; runner FAST/DEEP tersedia pada ADP-02 dengan lifecycle ADP-03.
ADAPTIVE_MIN_UNIQUE_CANDIDATES=1
ADAPTIVE_MIN_SELECTED_CHUNKS=1
ADAPTIVE_MIN_SKILL_COVERAGE=1

# ADP-02 provisional deep path: maksimum 2 stages/1 actual rewrite; rewrite tidak di-retry.
ADAPTIVE_REWRITE_ENABLED=false
ADAPTIVE_REWRITE_MODEL=gpt-5.6-terra
ADAPTIVE_RERANK_POOL_LIMIT=10

# ADP-03 runner internal bersama; retry opt-in, satu snapshot untuk semua mode.
# Retry provider/schema berbagi batas total; timeout/outcome unknown tidak diulang otomatis.
PIPELINE_MAX_PROVIDER_RETRIES=0
PIPELINE_MAX_SCHEMA_RETRIES=0
PIPELINE_MAX_TOTAL_RETRIES=0
PIPELINE_MAX_MODEL_CALLS=72
PIPELINE_BACKOFF_BASE_MS=250
PIPELINE_BACKOFF_MAX_MS=2000
# Minimum budget callback audit; tidak mengizinkan inference setelah deadline request.
PIPELINE_TRACE_GRACE_MS=1000

# UC-02: server-controlled approved bundle and exact full manifest SHA-256.
# Missing bundle disables production FREE_RESPONSE evaluation (no legacy fallback).
UC02_RUBRIC_BUNDLE=research/rubrics/uc-02-v1/bundle.json
UC02_RUBRIC_BUNDLE_SHA256=<sha256-of-bundle.json>
