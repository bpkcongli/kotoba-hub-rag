                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "\\S"
                  },
                  "fileSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "role": {
                    "enum": [
                      "CURRENT_BEHAVIOR",
                      "PROPOSED_POLICY",
                      "CURRICULUM_SCOPE"
                    ]
                  }
                },
                "required": [
                  "repository",
                  "path",
                  "fileSha256",
                  "role"
                ]
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            },
            "license": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "usageScope": {
              "enum": [
                "DESIGN_REVIEW_ONLY",
                "INTERNAL_RUNTIME"
              ]
            }
          },
          "required": [
            "authorship",
            "sourceRefs",
            "license",
            "usageScope"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "revision",
        "status",
        "contentSha256",
        "content",
        "approval",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "DRAFT"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "approval": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "approvedBy": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "approvedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reviewedContentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "approvedBy",
                  "role",
                  "approvedAt",
                  "reviewedContentSha256"
                ]
              }
            }
          }
        }
      ]
    },
    "assessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "FREE_RESPONSE_ASSESSMENT"
            },
            "outcome": {
              "const": "GRADED"
            },
            "scores": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "meaning": {
                  "enum": [
                    0,
                    20,
                    40,
                    60
                  ]
                },
                "grammar": {
                  "enum": [
                    0,
                    10,
                    20,
                    30
                  ]
                },
                "naturalness": {
                  "enum": [
                    0,
                    5,
                    10
                  ]
                }
              },
              "required": [
                "meaning",
                "grammar",
                "naturalness"
              ]
            },
            "feedbackText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "outcome",
            "scores",
            "feedbackText"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "FREE_RESPONSE_ASSESSMENT"
            },
            "outcome": {
              "const": "UNGRADABLE"
            },
            "reason": {
              "enum": [
                "SOURCE_AMBIGUOUS",
                "SOURCE_REFERENCE_CONFLICT",
                "NORMALIZATION_CONFLICT"
              ]
            }
          },
          "required": [
            "kind",
            "outcome",
            "reason"
          ]
        }
      ]
    },
    "publicGrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isCorrect": {
          "type": "boolean"
        },
        "numericScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "feedbackText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "isCorrect",
        "numericScore",
        "feedbackText"
      ]
    },
    "traceBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policyRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "contentSha256"
          ]
        },
        "guidanceRefs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "contentSha256"
            ]
          }
        },
        "corpusVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "scoringAlgorithmVersion": {
          "const": "SUM_THEN_CAP_V1"
