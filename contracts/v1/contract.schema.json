          "type": "object",
          "properties": {
            "currency": {
              "const": "USD"
            },
            "inference_total_usd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "query_embedding_usd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "rerank_usd": {
